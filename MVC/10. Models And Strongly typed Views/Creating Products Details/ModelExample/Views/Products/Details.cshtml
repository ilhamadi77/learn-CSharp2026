
@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>
<table class="table">
    <tr>
        <th>
            Product Id
        </th>
        <td>@ViewBag.ProductMatching.ProductId</td>
    </tr>
    <tr>
        <th>
            Product Name
        </th>
        <td>@ViewBag.ProductMatching.ProductName</td>
    </tr>
    <tr>
        <th>
           Rate
        </th>
        <td>@ViewBag.ProductMatching.Rate</td>
    </tr>
</table>

